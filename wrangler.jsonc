{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiutmc-ecosystem",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "hiutmc.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
